# =============================================================================
# AURA Companion - environment configuration template
# =============================================================================
# Copy this file to `.env` (or set the values in your CI/build environment).
# NEVER commit real values. Keep this file as placeholders only.
#
# The Flutter app reads these at build time via --dart-define, e.g.:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<publishable-anon-key> \
#     --dart-define=API_BASE_URL=http://<DEVICE_IP>:80
#
# =============================================================================

# Supabase project URL (from the Supabase dashboard: Settings > API).
# The anon key is publishable by design; RLS protects your data.
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key.
# NEVER put the service_role key here - it bypasses Row Level Security.
SUPABASE_ANON_KEY=<your-publishable-anon-key>

# Optional default device REST API base URL used for LAN discovery.
# Leave empty to rely on in-app device configuration.
API_BASE_URL=

# -----------------------------------------------------------------------------
# The following are NOT used by the app; they are documented here only to make
# it clear that a real .env must never contain secrets, and to reserve slots
# for future cloud deployments.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# GOOGLE_STT_API_KEY=
# GOOGLE_TTS_API_KEY=
