# =============================================================================
# AURA AI Desktop Assistant - .env.example (TEMPLATE ONLY)
# =============================================================================
# The AURA firmware is a C++/Arduino project: it reads secrets from the
# git-ignored `secrets.h` file and NVS, NOT from environment variables.
#
# This file exists as a documented placeholder so any future tooling (CI,
# companion apps, scripts) uses a consistent, credential-free template.
#
# NEVER commit this file with real values, and never commit a real `.env`.
# Copy to `.env` locally if a tool needs it; `.env` is git-ignored.
# =============================================================================

# Gemini reasoning engine API key
GEMINI_API_KEY=

# Sarvam AI speech provider API key (placeholder - set when implemented)
SARVAM_API_KEY=

# Wi-Fi (used by setup AP only; normal Wi-Fi stored in NVS)
WIFI_SSID=
WIFI_PASSWORD=

# Supabase (reserved - not used by the firmware yet)
SUPABASE_URL=
SUPABASE_ANON_KEY=