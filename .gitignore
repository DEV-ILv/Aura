# =============================================================================
# AURA firmware - Git ignore rules
# =============================================================================
# SECURITY: never commit credentials, keys, or build artifacts.

# Real secrets live in secrets.h - this file is git-ignored.
# A committed template lives in secrets.h.example; copy it to secrets.h before
# building:  copy secrets.h.example secrets.h
secrets.h
secrets.h.bak

# Environment / credential files (defence in depth even if unused by the build)
.env
.env.*
!.env.example
.credentials
*.credentials.json
credentials.json
service-account.json
service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
local.properties
*.sqlite
*.sqlite3
*.db

# Signing/private key material (tools/generate_keypair output).
# Only the PUBLIC key (firmware_keys.h / keys/public.h) is ever committed.
keys/
*.pem
*.key
*.p12
*.pfx
*.csr
*.crt
*.pem.bak

# OTA / build output
build/
dist/
out/
node_modules/
__pycache__/
*.pyc
*.bin
*.elf
*.map
*.log
*.hex
*.tmp
*.bak
sig*.txt

# IDE / editor
.vscode/
.idea/
*.iml
*.swp
*.swo

# OS noise
Thumbs.db
.DS_Store

# Runtime / cache
data/cache/

# Python tooling caches
__pycache__/
*.pyc

# Companion app (build outputs are handled by its own .gitignore when it is
# moved into this repository)
*.apk
*.aab
